{
  "csv": "data/scaling100000/bot/NF-BoT-IoT-v2-uniform-pilot.csv",
  "dataset": "bot",
  "task": "binary",
  "features": [
    "L4_SRC_PORT",
    "L4_DST_PORT",
    "PROTOCOL",
    "L7_PROTO",
    "IN_BYTES",
    "IN_PKTS",
    "OUT_BYTES",
    "OUT_PKTS",
    "TCP_FLAGS",
    "FLOW_DURATION_MILLISECONDS"
  ],
  "categorical": [
    "PROTOCOL",
    "L7_PROTO"
  ],
  "split_seed": 42,
  "split_protocol": "conversation",
  "seeds": [
    7
  ],
  "device": "cpu",
  "threads": 1,
  "hidden": 16,
  "layers": 2,
  "dropout": 0.2,
  "learning_rate": 0.001,
  "weight_decay": 0.0001,
  "epochs": 10,
  "patience": 3,
  "train_partition_method": "random",
  "train_parts": 4,
  "max_edges_per_batch": 512,
  "bidirectional_messages": true,
  "methods": [
    "full"
  ],
  "partition_counts": [
    2,
    4,
    8
  ],
  "repeats": 2,
  "isolated_benchmarks": true,
  "data_scope": "uniform_pilot",
  "baselines": false,
  "synthetic": false,
  "source_audit": "data/scaling100000/bot/source_audit.json",
  "log_progress": true,
  "require_validation_class_coverage": true,
  "max_input_bytes": 536870912,
  "max_batch_tensor_bytes": 268435456
}
