{
  "csv": "data/NF-CSE-CIC-IDS2018-v2.csv",
  "dataset": "cse",
  "task": "multiclass",
  "features": [
    "L4_SRC_PORT",
    "L4_DST_PORT",
    "PROTOCOL",
    "L7_PROTO",
    "IN_BYTES",
    "IN_PKTS",
    "OUT_BYTES",
    "OUT_PKTS",
    "TCP_FLAGS",
    "FLOW_DURATION_MILLISECONDS"
  ],
  "categorical": [
    "PROTOCOL",
    "L7_PROTO"
  ],
  "split_seed": 42,
  "split_protocol": "conversation",
  "seeds": [
    7,
    19,
    43,
    73,
    101
  ],
  "device": "cpu",
  "threads": 4,
  "hidden": 64,
  "layers": 2,
  "dropout": 0.2,
  "learning_rate": 0.001,
  "weight_decay": 0.0001,
  "epochs": 100,
  "patience": 10,
  "train_partition_method": "random",
  "train_parts": 100,
  "max_edges_per_batch": 4096,
  "bidirectional_messages": true,
  "methods": [
    "full",
    "random",
    "metis"
  ],
  "partition_counts": [
    100,
    200,
    400,
    800,
    1000,
    2000
  ],
  "repeats": 5,
  "isolated_benchmarks": true,
  "data_scope": "full_dataset",
  "baselines": true,
  "synthetic": false
}
